{
  "name": "korda-js",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript unit tests and coverage for KORDA static assets",
  "type": "module",
  "scripts": {
    "lint": "eslint static/js/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
