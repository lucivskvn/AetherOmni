{
  "name": "korda-js",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript unit tests and coverage for KORDA static assets",
  "type": "module",
  "scripts": {
    "lint": "eslint static/js/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "devDependencies": {
    "@vitest/browser": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "vitest": "5.1.1"
  }
}
