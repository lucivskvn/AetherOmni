# KORDA local environment template — copy to .env and fill in values.
# .env is gitignored; never commit real secrets.

# ── Required for `docker compose up` ──────────────────────────────────────
# Password for the local SurrealDB container (compose fails without it).
SURREAL_PASS=change-me-local-only
# Optional: defaults to "root" inside the compose SurrealDB container.
SURREAL_USER=root

# ── Django ────────────────────────────────────────────────────────────────
# Any long random string for local dev. Production uses Secret Manager.
DJANGO_SECRET_KEY=change-me-local-only
# Leave unset for sqlite offline mode, or point at a local Postgres.
# DATABASE_URL=postgresql://user:pass@localhost:5432/korda

# ── Offline / feature flags ───────────────────────────────────────────────
# SURREALDB_OFFLINE=True  # use SQLite + in-memory SurrealDB fakes (README quickstart)
# DJANGO_DEBUG=True       # required for unencrypted ws SurrealDB transport in compose
# ENABLE_PERIODIC_MAINTENANCE=False

# ── Optional integrations (leave blank to disable) ────────────────────────
# GEMINI_API_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLIC_KEY=
# CF_TURNSTILE_SITE_KEY=
# SENTRY_DSN=

# ── Local admin bootstrap (offline/dev only — never set in production) ────
# Email that receives the local superuser stub; password auth only works
# when Supabase is unconfigured AND DJANGO_DEBUG or SURREALDB_OFFLINE is set.
# ADMIN_EMAIL=admin@example.com
# Password applied only when the local admin account is first created; it is
# ignored for existing accounts. Without it a random unrecoverable password is
# generated — recover via `python manage.py changepassword`.
# ADMIN_DEV_PASSWORD=change-me-local-only
